# ----------------------------------------
# DOSDP templates/patterns
# ----------------------------------------

PATTERN_TESTER          = dosdp validate -i
DOSDPT                  = dosdp-tools
PATTERN_RELEASE_FILES   = $(PATTERNDIR)/definitions.owl $(PATTERNDIR)/pattern.owl

ALL_PATTERN_FILES       = $(wildcard $(PATTERNDIR)/dosdp-patterns/*.yaml)
ALL_PATTERN_NAMES       = $(strip $(basename $(notdir $(ALL_PATTERN_FILES))))

PATTERN_CLEAN_FILES     = $(PATTERNDIR)/all_pattern_terms.txt \
                          $(DOSDP_OWL_FILES_DEFAULT) $(DOSDP_TERM_FILES_DEFAULT) \
                          $(DOSDP_OWL_FILES_AUTOMATIC) $(DOSDP_TERM_FILES_AUTOMATIC)

EXTERNAL_PATTERN_URLS   = $(strip $(shell test -f $(PATTERNDIR)/dosdp-patterns/external.txt && grep -v ^\# $(PATTERNDIR)/dosdp-patterns/external.txt))

.PHONY: pattern_clean
pattern_clean:
	rm -f $(PATTERN_CLEAN_FILES)

# Validation only reads the pattern files, so it runs regardless of PAT
.PHONY: pattern_schema_checks dosdp_validation
pattern_schema_checks dosdp_validation: $(TMPDIR)/stamp-pattern-schema-checks

$(TMPDIR)/stamp-pattern-schema-checks: $(ALL_PATTERN_FILES) | $(TMPDIR)
	$(PATTERN_TESTER) $(PATTERNDIR)/dosdp-patterns
	touch $@

ifeq ($(PAT),true)

.PHONY: patterns dosdp
patterns dosdp: dosdp_validation $(PATTERNDIR)/pattern.owl $(PATTERNDIR)/definitions.owl

.PHONY: download_patterns
download_patterns: | $(TMPDIR)
	mkdir -p $(TMPDIR)/dosdp
	$(foreach url, $(EXTERNAL_PATTERN_URLS), \
	          odk-helper download --output $(TMPDIR)/dosdp/$(notdir $(url)) \
	                              --reference $(PATTERNDIR)/dosdp-patterns/$(notdir $(url)) \
	                              $(url);)

.PHONY: update_patterns
update_patterns: download_patterns
	@for f in $$(find $(TMPDIR) -type f -path '$(TMPDIR)/dosdp/*.yaml') ; do \
	        cp $$f $(PATTERNDIR)/dosdp-patterns ;
	done

ifeq ($(MIR),true)
$(PATTERNDIR)/dosdp-patterns/%.yaml: download_patterns
	@if [ -f $(TMPDIR)/dosdp/$*.yaml ]; then \
	        cp $(TMPDIR)/dosdp/$*.yaml $@ ; \
	fi
endif

# DOSDP pipelines
# ----------------------------------------
# Each pipeline gets its own directory structure.

# DOSDP default pipeline
DOSDP_TSV_FILES_DEFAULT     = $(wildcard $(PATTERNDIR)/data/default/*.tsv)
DOSDP_PATTERN_NAMES_DEFAULT = $(strip $(basename $(notdir $(DOSDP_TSV_FILES_DEFAULT))))
DOSDP_OWL_FILES_DEFAULT     = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/data/default/$(name).ofn)
DOSDP_TERM_FILES_DEFAULT    = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/data/default/$(name).txt)
DOSDP_YAML_FILES_DEFAULT    = $(foreach name, $(DOSDP_PATTERN_NAMES_DEFAULT), $(PATTERNDIR)/dosdp-patterns/$(name).yaml)

$(DOSDP_OWL_FILES_DEFAULT): $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_DEFAULT) $(ALL_PATTERN_FILES)
	if [ "${DOSDP_PATTERN_NAMES_DEFAULT}" ] ; then \
	        $(DOSDPT) generate --catalog=$(CATALOG) \
	                           --infile=$(PATTERNDIR)/data/default/ \
	                           --template=$(PATTERNDIR)/dosdp-patterns \
	                           --batch-patterns="$(DOSDP_PATTERN_NAMES_DEFAULT)" \
	                           --ontology=$< \
	                           --obo-prefixes=true \
	                           --outfile=$(PATTERNDIR)/data/default ; \
	fi

.PHONY: dosdp-docs-default
dosdp-docs-default: $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_DEFAULT) $(DOSDP_YAML_FILES_DEFAULT)
	mkdir -p $(DOCSDIR)/patterns/default
	$(DOSDPT) docs --obo-prefixes=true \
	               --catalog=$(CATALOG) \
	               --ontology=$< \
	               --infile=$(PATTERNDIR)/data/default \
	               --template=$(PATTERNDIR)/dosdp-patterns \
	               --batch-patterns="$(DOSDP_PATTERN_NAMES_DEFAULT)" \
	               --data-location-prefix=https://github.com/obophenotype/upheno/tree/master/src/patterns/data/default \
	               --outfile=$(DOCSDIR)/patterns/default

# DOSDP automatic pipeline
DOSDP_TSV_FILES_AUTOMATIC     = $(wildcard $(PATTERNDIR)/data/automatic/*.tsv)
DOSDP_PATTERN_NAMES_AUTOMATIC = $(strip $(basename $(notdir $(DOSDP_TSV_FILES_AUTOMATIC))))
DOSDP_OWL_FILES_AUTOMATIC     = $(foreach name, $(DOSDP_PATTERN_NAMES_AUTOMATIC), $(PATTERNDIR)/data/automatic/$(name).ofn)
DOSDP_TERM_FILES_AUTOMATIC    = $(foreach name, $(DOSDP_PATTERN_NAMES_AUTOMATIC), $(PATTERNDIR)/data/automatic/$(name).txt)
DOSDP_YAML_FILES_AUTOMATIC    = $(foreach name, $(DOSDP_PATTERN_NAMES_AUTOMATIC), $(PATTERNDIR)/dosdp-patterns/$(name).yaml)

$(DOSDP_OWL_FILES_AUTOMATIC): $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_AUTOMATIC) $(ALL_PATTERN_FILES)
	if [ "${DOSDP_PATTERN_NAMES_AUTOMATIC}" ] ; then \
	        $(DOSDPT) generate --catalog=$(CATALOG) \
	                           --infile=$(PATTERNDIR)/data/automatic \
	                           --template=$(PATTERNDIR)/dosdp-patterns/ \
	                           --batch-patterns="$(DOSDP_PATTERN_NAMES_AUTOMATIC)" \
	                           --ontology=$< \
	                           --obo-prefixes=true \
	                           --outfile=$(PATTERNDIR)/data/automatic; \
	fi

.PHONY: dosdp-docs-automatic
dosdp-docs-automatic: $(EDIT_PREPROCESSED) $(DOSDP_TSV_FILES_AUTOMATIC) $(DOSDP_YAML_FILES_AUTOMATIC)
	mkdir -p $(DOCSDIR)/patterns/automatic
	$(DOSDPT) docs --obo-prefixes=true \
	               --catalog=$(CATALOG) \
	               --ontology=$< \
	               --infile=$(PATTERNDIR)/data/automatic \
	               --template=$(PATTERNDIR)/dosdp-patterns \
	               --batch-patterns="$(DOSDP_PATTERN_NAMES_AUTOMATIC)" \
	               --data-location-prefix=https://github.com/obophenotype/upheno/tree/master/src/patterns/data/automatic \
	               --outfile=$(DOCSDIR)/patterns/automatic

# Template seeds
# ----------------------------------------

$(PATTERNDIR)/data/default/%.txt: $(PATTERNDIR)/dosdp-patterns/%.yaml $(PATTERNDIR)/data/default/%.tsv
	$(DOSDPT) terms --infile=$(PATTERNDIR)/data/default/$*.tsv --template $< \
	                --obo-prefixes=true --outfile=$@

$(PATTERNDIR)/data/automatic/%.txt: $(PATTERNDIR)/dosdp-patterns/%.yaml $(PATTERNDIR)/data/automatic/%.tsv
	$(DOSDPT) terms --infile=$(PATTERNDIR)/data/automatic/$*.tsv --template $< \
	                --obo-prefixes=true --outfile=$@

# Generating the seed file from all the TSVs.
$(TMPDIR)/all_pattern_terms.txt: $(DOSDP_TERM_FILES_DEFAULT) \
                                 $(DOSDP_TERM_FILES_AUTOMATIC) \
                                 $(TMPDIR)/pattern_owl_seed.txt
	cat $^ | sort | uniq > $@

$(TMPDIR)/pattern_owl_seed.txt: $(PATTERNDIR)/pattern.owl
	$(ROBOT) query --input $< --use-graphs true --format csv \
	               --query $(SPARQLDIR)/terms.sparql $@

# Pattern pipeline main targets: the generated OWL files
# ----------------------------------------

# An ontology of all DOSDP patterns
$(PATTERNDIR)/pattern.owl: $(ALL_PATTERN_FILES)
	$(DOSDPT) prototype --template=$(PATTERNDIR)/dosdp-patterns \
	                    --obo-prefixes=true --outfile=$@

# The component containing all pattern-derived axioms
$(PATTERNDIR)/definitions.owl: $(DOSDP_OWL_FILES_DEFAULT) \
                               $(DOSDP_OWL_FILES_AUTOMATIC)
	if [ "${DOSDP_PATTERN_NAMES_DEFAULT}" ] \
	        || [ "${DOSDP_PATTERN_NAMES_AUTOMATIC}" ] ; then \
	        $(ROBOT) merge $(addprefix --input , $^) \
	                 annotate --ontology-iri $(ONTBASE)/patterns/definitions.owl \
	                          --version-iri $(ONTBASE)/releases/$(TODAY)/patterns/definitions.owl \
	                          --annotation owl:versionInfo $(VERSION) \
	                 convert --format ofn --output $@ ; \
	fi

else # PAT=false
# Even if pattern generation is disabled, we still extract a seed from definitions.owl
$(TMPDIR)/all_pattern_terms.txt: $(PATTERNDIR)/definitions.owl
	$(ROBOT) query --input $< --use-graphs true --format csv \
	               --query $(SPARQLDIR)/terms.sparql $@
endif


# ----------------------------------------
# Release artefacts
# ----------------------------------------

SHARED_ROBOT_COMMANDS          =
ROBOT_RELEASE_IMPORT_MODE      = $(ROBOT) merge --input $<
ROBOT_RELEASE_IMPORT_MODE_BASE = $(ROBOT) remove --input $< --select imports --trim false \
                                          merge $(foreach src, $(OTHER_SRC), --input $(src))

MAIN_PRODUCTS = $(sort $(foreach a, $(RELEASE_ARTEFACTS), $(a)) $(ONT))
MAIN_FILES    = $(foreach p, $(MAIN_PRODUCTS), $(p).owl $(p).obo $(p).json )

.PHONY: all_main
all_main: $(MAIN_FILES) check_rdfxml_products

.PHONY: check_rdfxml_products
check_rdfxml_products: $(foreach product, $(MAIN_PRODUCTS), check_rdfxml_$(product).owl)

check_rdfxml_%: %
	@odk-helper check-rdfxml $<

# Release artefacts: main pipelines
# ----------------------------------------

KEEPRELATIONS = keeprelations.txt
SIMPLESEED    = $(TMPDIR)/simple_seed.txt

$(SIMPLESEED): $(SRCMERGED)
	$(ROBOT) query --input $< --format csv \
	               --query $(SPARQLDIR)/simple-seed.sparql $@.1.tmp \
	               --query $(SPARQLDIR)/upheno_terms.sparql $@.2.tmp
	cat $@.1.tmp $@.2.tmp | sort | uniq > $@
	echo "http://www.geneontology.org/formats/oboInOwl#SubsetProperty" >> $@
	echo "http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty" >> $@

# The primary release artefact.
$(ONT).owl: $(ONT)-full.owl
	$(ROBOT) annotate --input $< --ontology-iri $(URIBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) --output $@

# Base: A version of the ontology in which axioms outside of the
# ontology's namespace(s) are forcibly removed.
$(ONT)-base.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)
	$(ROBOT_RELEASE_IMPORT_MODE) \
	         reason --reasoner $(REASONER) \
	                --equivalent-classes-allowed all \
	                --exclude-tautologies structural \
	                --annotate-inferred-axioms false \
	         relax $(RELAX_OPTIONS) \
	         reduce --reasoner $(REASONER) $(REDUCE_OPTIONS) \
	         remove --base-iri http://purl.obolibrary.org/obo/UPHENO_ \
	                --axioms external --preserve-structure false --trim false \
	         $(SHARED_ROBOT_COMMANDS) \
	         annotate --link-annotation http://purl.org/dc/elements/1.1/type http://purl.obolibrary.org/obo/IAO_8000001 \
	                  --ontology-iri $(ONTBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) \
	                  --output $@

# Full: The full artefacts with imports merged, reasoned.
$(ONT)-full.owl: $(EDIT_PREPROCESSED) $(OTHER_SRC) $(IMPORT_FILES)
	$(ROBOT_RELEASE_IMPORT_MODE) \
	         reason --reasoner $(REASONER) \
	                --equivalent-classes-allowed all \
	                --exclude-tautologies structural \
	         relax $(RELAX_OPTIONS) \
	         reduce --reasoner $(REASONER) $(REDUCE_OPTIONS) \
	         $(SHARED_ROBOT_COMMANDS) \
	         annotate --ontology-iri $(ONTBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) \
	                  --output $@


# Basic: A version of the ontology that is reasoned
# and from which all axioms referring to an entity outside
# of the ontology's namespace(s) are forcibly removed, as well
# as all relationships not whitelisted in KEEPRELATIONS.
$(ONT)-basic.owl: $(EDIT_PREPROCESSED) $(SIMPLESEED) $(KEEPRELATIONS) $(OTHER_SRC) $(IMPORT_FILES)
	$(ROBOT_RELEASE_IMPORT_MODE) \
	         reason --reasoner $(REASONER) \
	                --equivalent-classes-allowed all \
	                --exclude-tautologies structural \
	                --annotate-inferred-axioms false \
	         relax $(RELAX_OPTIONS) \
	         remove --axioms equivalent \
	         remove --axioms disjoint \
	         remove --term-file $(KEEPRELATIONS) \
	                --select complement --select object-properties --trim true \
	         filter --term-file $(SIMPLESEED) \
	                --select "annotations ontology anonymous self" \
	                --trim true --signature true \
	         reduce --reasoner $(REASONER) $(REDUCE_OPTIONS) \
	         $(SHARED_ROBOT_COMMANDS) \
	         annotate --ontology-iri $(ONTBASE)/$@ \
	         $(ANNOTATE_ONTOLOGY_VERSION) \
	                  --output $@

upheno-base-with-bridge.owl:
	@echo "ERROR: You have configured a custom release artefact ($@);"
	@echo "       this artefact needs to be defined in upheno.Makefile!"
	@false

