## ONTOLOGY: bfo
.PHONY: download-mirror-bfo
download-mirror-bfo: | $(TMPDIR)
	odk-helper download --output $(TMPDIR)/$@.owl \
	                    --reference $(MIRRORDIR)/bfo.owl \
	                    --max-retry 4 \
	                    $(OBOBASE)/bfo.owl

$(MIRRORDIR)/bfo.owl: download-mirror-bfo
	@if [ -f $(TMPDIR)/download-mirror-bfo.owl ]; then \
	        $(ROBOT) remove --input $(TMPDIR)/download-mirror-bfo.owl \
	                        --base-iri http://purl.obolibrary.org/obo/BFO \
