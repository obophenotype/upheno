        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001470"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002305"/>
        <obo:IAO_0000115>An increased quality inhering in a bearer by virtue of the bearer&apos;s increased magnitude in proportion to the magnitude of another entity.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
        <oboInOwl:hasExactSynonym>increased proportion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>increased proportionality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>increased proportionality to</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>increased quotient</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0040043</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#relational_slim"/>
        <rdfs:comment>Example: increased proportion of CD4 T cells relative to total T cells.</rdfs:comment>
        <rdfs:label>increased ratio</rdfs:label>
